<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF9F6"
    tools:context=".petcreate.PetCreateActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="新增寵物資料"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#265B6A"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <ImageView
            android:id="@+id/ivSelectPhoto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/tvSelectPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="點擊新增照片"
            android:textSize="12sp"
            android:textColor="#888888"
            app:layout_constraintTop_toBottomOf="@+id/ivSelectPhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 1. 必填：寵物名稱 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="寵物名字 (必填) *"
            app:layout_constraintTop_toBottomOf="@+id/tvSelectPhoto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 🌟 修改：物種 (下拉選單) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutSpecies"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="物種 (必填) *"
            app:layout_constraintTop_toBottomOf="@+id/layoutName">
            <!-- 注意：inputType 必須設為 none，這樣點擊時才不會彈出鍵盤 -->
            <AutoCompleteTextView
                android:id="@+id/editSpecies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 🌟 修改：品種 (下拉選單，會跟隨物種改變) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutBreed"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="品種"
            app:layout_constraintTop_toBottomOf="@+id/layoutSpecies">
            <AutoCompleteTextView
                android:id="@+id/editBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 🌟 新增：性別 (下拉選單) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutGender"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="性別"
            app:layout_constraintTop_toBottomOf="@+id/layoutBreed">
            <AutoCompleteTextView
                android:id="@+id/editGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 🌟 新增：生日 (點擊彈出月曆) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDob"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="生日 (YYYY-MM-DD)"
            app:layout_constraintTop_toBottomOf="@+id/layoutGender">
            <!-- focusable 設為 false，避免游標閃爍；改用點擊事件觸發 -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 4. 選填：晶片號碼 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMicrochip"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="晶片號碼 (選填)"
            app:layout_constraintTop_toBottomOf="@+id/layoutDob">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editMicrochip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 🌟 新增：特殊注意事項 (多行輸入) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNotes"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="特殊注意事項 (例如：對藥物過敏...)"
            app:layout_constraintTop_toBottomOf="@+id/layoutMicrochip">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 儲存按鈕 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="儲存資料"
            android:textSize="18sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#265B6A"
            app:layout_constraintTop_toBottomOf="@+id/layoutNotes" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>