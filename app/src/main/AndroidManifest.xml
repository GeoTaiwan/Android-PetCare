<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetCare"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".appointment.AppointmentListActivity"
            android:exported="false" />
        <activity
            android:name=".appointment.ReservationActivity"
            android:exported="false" />
        <activity
            android:name=".caregroominglog.CareGroomingLogListActivity"
            android:exported="false" />
        <activity
            android:name=".medicalrecord.create.MedicalRecordCreateActivity"
            android:exported="false" />
        <activity
            android:name=".medicalrecord.MedicalRecordListActivity"
            android:exported="false" />
        <activity
            android:name=".petcreate.PetCreateActivity"
            android:exported="false" />
        <activity
            android:name=".petdetail.PetDetailActivity"
            android:exported="false" />
        <activity
            android:name=".petlist.PetListActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>